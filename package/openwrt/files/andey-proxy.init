#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/andey-proxy

start_service() {
	local enabled confdir port admin_http
	config_load andey-proxy
	config_get enabled main enabled 0
	config_get confdir main confdir /etc/andey-proxy
	config_get port main port 16601
	config_get admin_http main admin_http 0

	[ "$enabled" = "1" ] || return 0
	case "$confdir" in
		""|/|/etc|/usr|/var|/tmp|/root|/home)
			echo "andey-proxy: 拒绝使用不安全的配置目录: $confdir" >&2
			return 1
			;;
	esac

	# -p 不会修改已存在父目录的权限；程序在解析并拒绝根目录后会再次收紧为 0700。
	mkdir -p -m 700 "$confdir"
	procd_open_instance andey-proxy
	procd_set_param command "$PROG" -cd "$confdir" -p "$port"
	[ "$admin_http" = "1" ] && procd_append_param command -admin-http
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	service_stop "$PROG" 2>/dev/null
}
