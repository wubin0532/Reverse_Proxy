{
	"luci-app-andeyproxy": {
		"description": "andey-Proxy 设置与状态访问。初始密码仅授权给拥有本插件写权限的管理员，改密后程序会删除该文件。",
		"read": {
			"uci": [ "andey-proxy" ],
			"ubus": {
				"luci": [ "getInitList" ],
				"system": [ "board" ],
				"service": [ "list" ],
				"file": [ "read" ]
			},
			"file": {
				"/etc/andey-proxy/version": [ "read" ]
			}
		},
		"write": {
			"uci": [ "andey-proxy" ],
			"file": {
				"/etc/andey-proxy/initial-password": [ "read" ]
			},
			"ubus": {
				"luci": [ "setInitAction" ]
			}
		}
	}
}
